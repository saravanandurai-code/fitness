# Fitraa runs without these: with no Supabase project configured the app stores
# everything on the device instead, which is handy for development.
#
# Fill both in (Supabase dashboard → Project Settings → API) to switch the app
# onto Supabase, then apply src/lib/supabase/schema.sql to the project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
